---
import "../styles/global.css";
import { getLang, t } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.currentLocale);
const {
  title = t("meta.title", lang),
  description = t("meta.description", lang),
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const altLang = lang === "en" ? "ja" : "en";
const altPath = lang === "en" ? "/ja/" : "/";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={altLang} href={new URL(altPath, Astro.site).href} />
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site).href} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@sugertiger77" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site).href} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // The opening loader plays once per visit; skip it for repeat visits and reduced motion.
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('intro-played')) {
          document.documentElement.classList.add('is-open', 'intro-done');
        } else {
          sessionStorage.setItem('intro-played', '1');
        }
      } catch {
        document.documentElement.classList.add('is-open', 'intro-done');
      }
      try {
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch {
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark');
      }
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "sugertiger77",
      "url": "https://sugertiger77.com",
      "sameAs": [
        "https://github.com/tora-opinion"
      ]
    })} />
  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="skip-link">{t("a11y.skipToContent", lang)}</a>
    <div class="loader" aria-hidden="true">
      <i class="loader-panel loader-top"></i>
      <i class="loader-panel loader-bottom"></i>
      <span class="loader-corner tl"></span><span class="loader-corner tr"></span>
      <span class="loader-corner bl"></span><span class="loader-corner br"></span>
      <span class="loader-gate" data-loader-gate></span>
      <span class="loader-title mono" data-loader-title>sugertiger77</span>
      <span class="loader-count mono" data-loader-count>000</span>
      <span class="loader-caption mono">{title}</span>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <script is:inline>
      const animatedElements = document.querySelectorAll('.animate-on-scroll');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        animatedElements.forEach((element) => element.classList.add('animate-visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('animate-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
        animatedElements.forEach((element) => observer.observe(element));
      }
    </script>
    <script is:inline>
      // Opening loader: the gate line and counter follow the real load of the hero photo and fonts.
      (function () {
        var root = document.documentElement;
        if (root.classList.contains('is-open')) return;
        var count = document.querySelector('[data-loader-count]');
        var title = document.querySelector('[data-loader-title]');
        var gate = document.querySelector('[data-loader-gate]');
        var word = 'sugertiger77';
        var glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#*+';
        var hero = document.querySelector(root.classList.contains('dark') ? '.hero-bg .photo-dark' : '.hero-bg .photo-light');
        var waits = [document.fonts ? document.fonts.ready : Promise.resolve()];
        if (hero && hero.decode) waits.push(hero.decode().catch(function () {}));
        var ready = false;
        var opened = false;
        Promise.all(waits).then(function () { ready = true; });
        var start = performance.now();
        var shown = 0;
        var tick = 0;
        var open = function () {
          if (opened) return;
          opened = true;
          if (title) title.textContent = word;
          if (count) count.textContent = '100';
          if (gate) gate.style.transform = 'scaleX(1)';
          root.classList.add('is-ready');
          setTimeout(function () { root.classList.add('is-open'); }, 600);
          setTimeout(function () { root.classList.add('intro-done'); }, 2400);
        };
        // Never hold the page hostage: open after 4s whatever happens.
        setTimeout(open, 4000);
        var frame = function (now) {
          if (opened) return;
          var t = (now - start) / 1000;
          var target = ready && t > 1.3 ? 1 : 0.88 * (1 - Math.exp(-t * 1.5));
          shown += (target - shown) * 0.09;
          if (target === 1 && shown > 0.995) shown = 1;
          if (count) count.textContent = String(Math.round(shown * 100)).padStart(3, '0');
          if (gate) gate.style.transform = 'scaleX(' + shown + ')';
          if (title && tick++ % 3 === 0) {
            var fixed = Math.floor(shown * word.length);
            var text = word.slice(0, fixed);
            for (var i = fixed; i < word.length; i++) text += glyphs[Math.floor(Math.random() * glyphs.length)];
            title.textContent = text;
          }
          if (shown === 1) open();
          else requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      })();
    </script>
    <script>
      import { initCinematic } from "../scripts/cinematic";
      initCinematic();
    </script>
  </body>
</html>
