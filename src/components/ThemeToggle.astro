---
import { getLang, t } from "../i18n/utils";
const lang = getLang(Astro.currentLocale);
const useDarkLabel = t("theme.useDark", lang);
const useLightLabel = t("theme.useLight", lang);
---
<button
  id="theme-toggle"
  type="button"
  class="icon-btn"
  aria-label={useDarkLabel}
  aria-pressed="false"
  data-use-dark-label={useDarkLabel}
  data-use-light-label={useLightLabel}
>
  <svg aria-hidden="true" class="hidden h-5 w-5 dark:block" fill="currentColor" viewBox="0 0 20 20">
    <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd" />
  </svg>
  <svg aria-hidden="true" class="block h-5 w-5 dark:hidden" fill="currentColor" viewBox="0 0 20 20">
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
  </svg>
</button>
<script is:inline>
  const themeToggle = document.getElementById('theme-toggle');
  const syncThemeToggle = () => {
    if (!themeToggle) return;
    const isDark = document.documentElement.classList.contains('dark');
    themeToggle.setAttribute('aria-pressed', String(isDark));
    themeToggle.setAttribute('aria-label', isDark ? themeToggle.dataset.useLightLabel : themeToggle.dataset.useDarkLabel);
  };
  syncThemeToggle();
  themeToggle?.addEventListener('click', () => {
    const html = document.documentElement;
    if (html.classList.contains('dark')) {
      html.classList.remove('dark');
      localStorage.theme = 'light';
    } else {
      html.classList.add('dark');
      localStorage.theme = 'dark';
    }
    syncThemeToggle();
  });
</script>
