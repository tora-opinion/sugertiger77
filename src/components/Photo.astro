---
import { photos, type PhotoKey } from "../data/photos";

interface Props {
  name: PhotoKey;
  eager?: boolean;
  /** Use the 800px copy in /img/thumb/ (for small tiles). */
  thumb?: boolean;
}
const { name, eager = false, thumb = false } = Astro.props;
const slot = photos[name];
const loading = eager ? "eager" : "lazy";
const src = (path: string) => (thumb ? path.replace("/img/", "/img/thumb/") : path);
const [width, height] = thumb ? [800, 560] : [2000, 1333];
---
<img class="photo photo-light" src={src(slot.light.src)} alt="" width={width} height={height} loading={loading} decoding="async" fetchpriority={eager ? "high" : undefined} />
<img class="photo photo-dark" src={src(slot.dark.src)} alt="" width={width} height={height} loading={loading} decoding="async" />
