---
import type { Project } from "../i18n/projects";
import type { Locale } from "../i18n/translations";
import TechBadge from "./TechBadge.astro";
import { t } from "../i18n/utils";

interface Props {
  project: Project;
  lang: Locale;
  /** Show the project name as a heading (the pinned panel does; the inline list already has it). */
  showTitle?: boolean;
}
const { project, lang, showTitle = false } = Astro.props;

const statusMap = {
  "In Development": "status.inDevelopment",
  "Live": "status.live",
  "Beta": "status.beta",
} as const;
---
{showTitle && (
  <Fragment>
    <div class="pv-head">
      <span class="mono">{project.japaneseName}</span>
      <span class="tag">{t(statusMap[project.status], lang)}</span>
    </div>
    <p class="pv-title">{project.name}</p>
  </Fragment>
)}
{!showTitle && <span class="tag mt-3 inline-block">{t(statusMap[project.status], lang)}</span>}
<p class="mono pv-label">{t("projects.stack", lang)}</p>
<div class="chips">
  {project.tech.map((techName) => <TechBadge name={techName} />)}
</div>
<p class="mono pv-label">{t("projects.features", lang)}</p>
<ul class="feature-list">
  {project.features.map((feature) => <li>{feature}</li>)}
</ul>
<div class="pv-foot">
  {project.isPublic === false ? (
    <span class="site">{t("projects.privatePreview", lang)}</span>
  ) : project.url ? (
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t("projects.visitSiteLabel", lang, { name: project.name })}
      class="site"
    >
      {t("projects.visitSite", lang)}
    </a>
  ) : (
    <span class="mail">{t("projects.comingSoon", lang)}</span>
  )}
  {project.contact && (
    <a
      href={`mailto:${project.contact}`}
      aria-label={t("projects.emailLabel", lang, { name: project.name, email: project.contact })}
      class="mail"
    >{project.contact}</a>
  )}
</div>
