---
import { getLang, t } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
// Japanese lights up character by character, English word by word.
const description = t("about.description", lang);
const units = lang === "ja" ? Array.from(description) : description.split(/(\s+)/);
---
<section id="about" aria-labelledby="about-heading" class="intro">
  <h2 id="about-heading" tabindex="-1" class="mono mb-9 animate-on-scroll animate-fade-in-up">
    — {t("about.title", lang)}
  </h2>
  <p class="intro-text" data-reveal>
    {units.map((unit) => (/^\s+$/.test(unit) ? unit : <span class="reveal-word">{unit}</span>))}
  </p>
</section>
