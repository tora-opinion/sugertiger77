---
import { stackUsage, projectCount } from "../data/stack";
import { getLang, t } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
// Tools shared by two or more products get the big type; the rest are listed small.
const shared = stackUsage.filter((tool) => tool.count > 1);
const single = stackUsage.filter((tool) => tool.count === 1);
---
<section id="stack" aria-labelledby="stack-heading" class="stack-sec">
  <div class="stack-head">
    <h2 id="stack-heading" class="mono">— {t("stack.title", lang)}</h2>
    <p class="stack-lead">{t("stack.lead", lang)}</p>
  </div>
  <ul class="stack-words">
    {shared.map((tool, i) => (
      <li class="animate-on-scroll animate-fade-in-up" style={`animation-delay: ${i * 0.05}s; --w: ${tool.count / projectCount}`}>
        <span class="sw-name">{tool.name}</span>
        <span class="sw-count mono" aria-hidden="true">{tool.count}</span>
        <span class="sr-only">{t("stack.count", lang, { count: String(tool.count), total: String(projectCount) })}</span>
      </li>
    ))}
  </ul>
  <p class="stack-rest mono"><span class="stack-rest-label">{t("stack.single", lang)}</span>{single.map((tool) => tool.name).join(" · ")}</p>
</section>
