---
import { projects } from "../i18n/projects";
import { projectPhotoKeys } from "../data/photos";
import Photo from "./Photo.astro";
import { getLang, t } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const list = projects[lang];
const pad = (n: number) => String(n).padStart(2, "0");
const statusMap = {
  "In Development": "status.inDevelopment",
  "Live": "status.live",
  "Beta": "status.beta",
} as const;
// The first sentence of each description doubles as its one-liner.
const firstSentence = (text: string) => text.split(/(?<=[.。])\s*/)[0];
---
<section id="lineup" aria-labelledby="lineup-heading" class="lineup">
  <div class="lineup-head">
    <h2 id="lineup-heading" class="mono">— {t("lineup.title", lang)}</h2>
    <p class="lineup-lead">{t("lineup.lead", lang)}</p>
  </div>
  <ul class="tiles">
    {list.map((project, i) => (
      <li class="animate-on-scroll animate-fade-in-up" style={`animation-delay: ${(i % 3) * 0.08}s`}>
        <a
          href={`#work-${project.id}`}
          class="tile"
          data-work-jump={i}
          aria-label={t("lineup.jumpLabel", lang, { name: project.name })}
        >
          <div class="tile-ph">
            <Photo name={projectPhotoKeys[i % projectPhotoKeys.length]} thumb />
            <span class="tile-num mono">{pad(i + 1)}</span>
            <span class="tile-status mono">{t(statusMap[project.status], lang)}</span>
          </div>
          <div class="tile-body">
            <p class="tile-name">
              {project.name}
              {project.japaneseName && <span class="tile-ja">{project.japaneseName}</span>}
            </p>
            <p class="tile-desc">{firstSentence(project.description)}</p>
            <p class="tile-tech mono">{project.tech.slice(0, 3).join(" · ")}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
