---
import { photos } from "../data/photos";
import { getLang, t } from "../i18n/utils";
const lang = getLang(Astro.currentLocale);
const year = new Date().getFullYear().toString();
const credits = Object.values(photos).flatMap((slot) => [slot.light, slot.dark]);
---
<footer class="site-footer">
  <p>{t("footer.rights", lang, { year })}</p>
  <details class="credit">
    <summary>{t("footer.photos", lang)} <span class="credit-n">{credits.length}</span></summary>
    <p class="credit-note">
      {t("footer.photosNote", lang).split("Unsplash License")[0]}<a href="https://unsplash.com/license" target="_blank" rel="noopener noreferrer">Unsplash License</a>{t("footer.photosNote", lang).split("Unsplash License")[1]}
    </p>
    <ul class="credit-list">
      {credits.map((photo) => (
        <li><a href={`https://unsplash.com/photos/${photo.id}`} target="_blank" rel="noopener noreferrer">{photo.author}</a></li>
      ))}
    </ul>
  </details>
</footer>
