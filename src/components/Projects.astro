---
import { projects } from "../i18n/projects";
import { projectPhotoKeys } from "../data/photos";
import Photo from "./Photo.astro";
import { getLang, t } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const list = projects[lang];
const pad = (n: number) => String(n).padStart(2, "0");
const statusMap = {
  "In Development": "status.inDevelopment",
  "Live": "status.live",
  "Beta": "status.beta",
} as const;
---
<section id="projects" aria-labelledby="projects-heading">
  <div class="expand" data-expand>
    <div class="expand-stick">
      <div class="expand-frame" data-expand-frame><Photo name="frame" /></div>
      <div class="expand-cap" data-expand-cap>
        <h2 id="projects-heading" tabindex="-1">{t("projects.title", lang)}</h2>
        <p class="lead">{t("projects.subtitle", lang)}</p>
      </div>
    </div>
  </div>

  <div class="index" data-index>
    <p class="index-hint mono">{t("projects.hint", lang)}</p>
    <ol class="index-list" aria-label={t("projects.listLabel", lang)}>
      {list.map((project, i) => (
        <li id={`work-${project.id}`} class="row" data-row data-photo={i % projectPhotoKeys.length}>
          <h3>
            <button
              type="button"
              class="row-head"
              aria-expanded="false"
              aria-controls={`work-${project.id}-body`}
              data-row-btn
            >
              <span class="row-num mono">{pad(i + 1)}</span>
              <span class="row-name">{project.name}</span>
              <span class="row-ja">{project.japaneseName}</span>
              <span class="row-status mono">{t(statusMap[project.status], lang)}</span>
              <span class="row-plus" aria-hidden="true"></span>
            </button>
          </h3>
          <div id={`work-${project.id}-body`} class="row-body" data-row-body>
            <div class="row-inner">
              <p class="row-desc">{project.description}</p>
              <dl class="row-facts">
                <div>
                  <dt class="mono">{t("projects.stack", lang)}</dt>
                  <dd>{project.tech.join(" / ")}</dd>
                </div>
                <div>
                  <dt class="mono">{t("projects.features", lang)}</dt>
                  <dd>
                    <ul>{project.features.map((feature) => <li>{feature}</li>)}</ul>
                  </dd>
                </div>
              </dl>
              <p class="row-links">
                {project.isPublic === false ? (
                  <span class="mono">{t("projects.privatePreview", lang)}</span>
                ) : project.url ? (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={t("projects.visitSiteLabel", lang, { name: project.name })}
                    class="btn"
                  >{t("projects.visitSite", lang)}</a>
                ) : (
                  <span class="mono">{t("projects.comingSoon", lang)}</span>
                )}
                {project.contact && (
                  <a
                    href={`mailto:${project.contact}`}
                    aria-label={t("projects.emailLabel", lang, { name: project.name, email: project.contact })}
                    class="row-mail"
                  >{project.contact}</a>
                )}
              </p>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="peek" aria-hidden="true" data-peek>
      {projectPhotoKeys.map((key) => (
        <div class="peek-ph" data-peek-photo><Photo name={key} /></div>
      ))}
    </div>
  </div>
</section>
