---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { getLang, t } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const homePath = lang === "ja" ? "/ja/" : "/";
const sectionHref = (section: string) => `${homePath}#${section}`;
---

<header class="site-header fixed top-0 left-0 right-0 z-50">
  <nav aria-label="Primary" class="site-nav flex min-h-16 items-center justify-between px-4 sm:px-[clamp(20px,4vw,56px)]">
    <a href={homePath} aria-current="page" class="logo rounded-md">
      sugertiger77
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <a href={sectionHref("about")} data-section-link="about" class="nav-link max-sm:!hidden">{t("nav.about", lang)}</a>
      <a href={sectionHref("projects")} data-section-link="projects" class="nav-link max-sm:!hidden">{t("nav.projects", lang)}</a>
      <a href={sectionHref("contact")} data-section-link="contact" class="nav-link max-sm:!hidden">{t("nav.contact", lang)}</a>
      <details class="relative sm:hidden" data-mobile-nav>
        <summary
          class="icon-btn list-none [&::-webkit-details-marker]:hidden"
          aria-label={t("nav.openMenu", lang)}
          aria-expanded="false"
          aria-controls="mobile-navigation"
          data-open-label={t("nav.openMenu", lang)}
          data-close-label={t("nav.closeMenu", lang)}
        >
          <svg data-menu-open-icon class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg data-menu-close-icon class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </summary>
        <div id="mobile-navigation" class="mobile-nav-panel absolute right-0 top-12 w-52 overflow-hidden rounded-2xl p-1">
          <a href={sectionHref("about")} data-section-link="about" class="nav-link">{t("nav.about", lang)}</a>
          <a href={sectionHref("projects")} data-section-link="projects" class="nav-link">{t("nav.projects", lang)}</a>
          <a href={sectionHref("contact")} data-section-link="contact" class="nav-link">{t("nav.contact", lang)}</a>
        </div>
      </details>
      <LanguageToggle />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  const initializeHeader = () => {
    const mobileNav = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");
    if (!mobileNav || mobileNav.dataset.bound === "true") return;
    mobileNav.dataset.bound = "true";

    const summary = mobileNav.querySelector<HTMLElement>("summary");
    const openIcon = mobileNav.querySelector<HTMLElement>("[data-menu-open-icon]");
    const closeIcon = mobileNav.querySelector<HTMLElement>("[data-menu-close-icon]");
    const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-section-link]"));

    const closeMenu = (returnFocus = false) => {
      if (!mobileNav.open) return;
      mobileNav.open = false;
      if (returnFocus) summary?.focus();
    };

    const syncMenuState = () => {
      const isOpen = mobileNav.open;
      summary?.setAttribute("aria-expanded", String(isOpen));
      summary?.setAttribute(
        "aria-label",
        isOpen ? summary.dataset.closeLabel ?? "Close menu" : summary.dataset.openLabel ?? "Open menu",
      );
      openIcon?.classList.toggle("hidden", isOpen);
      closeIcon?.classList.toggle("hidden", !isOpen);
      document.documentElement.classList.toggle("mobile-nav-open", isOpen);
    };

    mobileNav.addEventListener("toggle", syncMenuState);
    mobileNav.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileNav.open) {
        event.preventDefault();
        closeMenu(true);
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (mobileNav.open && event.target instanceof Node && !mobileNav.contains(event.target)) {
        closeMenu();
      }
    });
    sectionLinks.forEach((link) => link.addEventListener("click", () => {
      const sectionId = link.dataset.sectionLink;
      const isMobileLink = mobileNav.contains(link);
      closeMenu();
      if (isMobileLink && sectionId) {
        requestAnimationFrame(() => {
          document.querySelector<HTMLElement>(`#${sectionId} [tabindex="-1"]`)?.focus({ preventScroll: true });
        });
      }
    }));
    window.addEventListener("hashchange", () => closeMenu());
    window.addEventListener("resize", () => {
      if (window.matchMedia("(min-width: 640px)").matches) closeMenu();
    });

    const setCurrentSection = (sectionId: string | null) => {
      sectionLinks.forEach((link) => {
        if (sectionId && link.dataset.sectionLink === sectionId) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };
    setCurrentSection(location.hash.slice(1) || null);

    const sections = ["about", "projects", "contact"]
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => Boolean(section));
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) setCurrentSection(visible.target.id);
      },
      { rootMargin: "-30% 0px -55%", threshold: [0, 0.25, 0.5] },
    );
    sections.forEach((section) => observer.observe(section));
    syncMenuState();
  };

  initializeHeader();
  document.addEventListener("astro:page-load", initializeHeader);
</script>
